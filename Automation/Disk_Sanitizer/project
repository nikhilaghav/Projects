    # Step 7 : Close connection manually
    smtp.quit()
   
# ------------------------------------------------- 
# Function : main # Description : Driver function of the program 
# -------------------------------------------------
    
def main():
    schedule.every(1).minute.do(DeleteDuplicate,"Test") 
                
    while True:
            schedule.run_pending()
            time.sleep(1)

# ------------------------------------------------- 
# Program Entry Point 
# -------------------------------------------------

if __name__ == "__main__":
    main()
