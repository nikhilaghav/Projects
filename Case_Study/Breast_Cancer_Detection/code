import pandas as pd

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import accuracy_score, confusion_matrix

from sklearn.linear_model import LogisticRegression
from sklearn.tree import DecisionTreeClassifier
from sklearn.neighbors import KNeighborsClassifier

from sklearn.ensemble import VotingClassifier


# Step 1 : Load Data

#-----------------------------------------------------
#   Function Name : LoadData
#   Description :   Load the data from CSV
#   Input :         Name of CSV file
#   Output :        Data Frame
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def LoadData(filename):

    df = pd.read_csv(filename)

    print("Dataset loaded successfully")

    print("Shape of dataset : ", df.shape)

    print("First few records : ")
    print(df.head())

    return df


# Step 2 : Separate Features and Labels

#-----------------------------------------------------
#   Function Name : SeparateFeatures
#   Description :   Separate features and target labels
#   Input :         Data Frame
#   Output :        Features and Labels
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def SeparateFeatures(df):

    X = df.drop("target", axis=1)

    Y = df["target"]

    print("Feature and label separation completed")

    print("X shape : ", X.shape)

    print("Y shape : ", Y.shape)

    return X, Y


# Step 3 : Split Data

#-----------------------------------------------------
#   Function Name : SplitData
#   Description :   It performs dataset splitting
#   Input :         Features and Labels
#   Output :        4 subsets for training and testing
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def SplitData(X, Y):

    X_train, X_test, Y_train, Y_test = train_test_split(
        X,
        Y,
        test_size=0.2,
        random_state=42
    )

    print("Dataset splitting completed successfully")

    return X_train, X_test, Y_train, Y_test


# Step 4 : Scale Features

#-----------------------------------------------------
#   Function Name : ScaleFeatures
#   Description :   It performs feature scaling
#   Input :         Training and testing features
#   Output :        Scaled training and testing features
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def ScaleFeatures(X_train, X_test):

    scaler = StandardScaler()

    X_train = scaler.fit_transform(X_train)

    X_test = scaler.transform(X_test)

    print("Feature scaling completed successfully")

    return X_train, X_test


# Step 5 : Create Individual Models

#-----------------------------------------------------
#   Function Name : CreateModels
#   Description :   Create individual ML models
#   Input :         None
#   Output :        Logistic Regression, Decision Tree,
#                   and KNN models
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def CreateModels():

    model_log = LogisticRegression(max_iter=1000)

    model_det = DecisionTreeClassifier(random_state=42)

    model_knn = KNeighborsClassifier(n_neighbors=5)

    print("Individual models created successfully")

    return model_log, model_det, model_knn


# Step 6 : Create Voting Classifier

#-----------------------------------------------------
#   Function Name : CreateVotingModel
#   Description :   Create Hard Voting Classifier
#   Input :         Individual ML models
#   Output :        Voting Classifier model
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def CreateVotingModel(model_log, model_det, model_knn):

    model = VotingClassifier(
        estimators=[
            ('logistic', model_log),
            ('decision_tree', model_det),
            ('knn', model_knn)
        ],
        voting='hard'
    )

    print("Voting Classifier created successfully")

    return model


# Step 7 : Train the Model

#-----------------------------------------------------
#   Function Name : TrainModel
#   Description :   It performs model training
#   Input :         Model, training features and labels
#   Output :        Trained model
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def TrainModel(model, X_train, Y_train):

    model = model.fit(X_train, Y_train)

    print("Model trained successfully")

    return model


# Step 8 : Evaluate Model

#-----------------------------------------------------
#   Function Name : EvaluateModel
#   Description :   It performs model testing
#   Input :         Model, testing features and labels
#   Output :        None
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def EvaluateModel(model, X_test, Y_test):

    Y_pred = model.predict(X_test)

    accuracy = accuracy_score(Y_test, Y_pred)

    print("Accuracy is : ", accuracy)

    print("Confusion Matrix : ")
    print(confusion_matrix(Y_test, Y_pred))


#-----------------------------------------------------
#   Function Name : main
#   Description :   Entry point function
#   Input :         None
#   Output :        None
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def main():

    # Step 1 : Load Data
    df = LoadData("breast_cancer.csv")

    # Step 2 : Separate Features and Labels
    X, Y = SeparateFeatures(df)

    # Step 3 : Split Data
    X_train, X_test, Y_train, Y_test = SplitData(X, Y)

    # Step 4 : Scale Features
    X_train, X_test = ScaleFeatures(X_train, X_test)

    # Step 5 : Create Individual Models
    model_log, model_det, model_knn = CreateModels()

    # Step 6 : Create Voting Classifier
    model = CreateVotingModel(model_log, model_det, model_knn)

    # Step 7 : Train Model
    model = TrainModel(model, X_train, Y_train)

    # Step 8 : Evaluate Model
    EvaluateModel(model, X_test, Y_test)


if __name__ == "__main__":
    main()
