import pandas as pd

from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeRegressor
from sklearn.ensemble import BaggingRegressor
from sklearn.metrics import mean_squared_error, r2_score


# Step 1 : Load Data

#-----------------------------------------------------
#   Function Name : LoadData
#   Description :   Load the data from CSV
#   Input :         Name of CSV file
#   Output :        Data Frame
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def LoadData(filename):

    df = pd.read_csv(filename)

    print("Dataset loaded successfully")

    print("Shape of dataset : ", df.shape)

    print("First few records : ")
    print(df.head())

    return df


# Step 2 : Separate Features and Labels

#-----------------------------------------------------
#   Function Name : SeparateFeatures
#   Description :   Separate features and target labels
#   Input :         Data Frame
#   Output :        Features and Labels
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def SeparateFeatures(df):

    X = df.drop("target", axis=1)

    Y = df["target"]

    print("Feature and label separation completed")

    print("Shape of X : ", X.shape)

    print("Shape of Y : ", Y.shape)

    return X, Y


# Step 3 : Split Data

#-----------------------------------------------------
#   Function Name : SplitData
#   Description :   It performs dataset splitting
#   Input :         Features and Labels
#   Output :        4 subsets for training and testing
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def SplitData(X, Y):

    X_train, X_test, Y_train, Y_test = train_test_split(
        X,
        Y,
        test_size=0.2,
        random_state=42
    )

    print("Dataset splitting completed successfully")

    return X_train, X_test, Y_train, Y_test


# Step 4 : Create Base Model

#-----------------------------------------------------
#   Function Name : CreateBaseModel
#   Description :   Create Decision Tree Regressor model
#   Input :         None
#   Output :        Decision Tree Regressor model
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def CreateBaseModel():

    base_model = DecisionTreeRegressor(random_state=42)

    print("Base model created successfully")

    return base_model


# Step 5 : Create Bagging Model

#-----------------------------------------------------
#   Function Name : CreateBaggingModel
#   Description :   Create Bagging Regressor model
#   Input :         Base Model
#   Output :        Bagging Regressor model
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def CreateBaggingModel(base_model):

    model = BaggingRegressor(
        estimator=base_model,
        n_estimators=10,
        random_state=42
    )

    print("Bagging Regressor created successfully")

    return model


# Step 6 : Train Model

#-----------------------------------------------------
#   Function Name : TrainModel
#   Description :   It performs model training
#   Input :         Model, training features and labels
#   Output :        Trained model
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def TrainModel(model, X_train, Y_train):

    model = model.fit(X_train, Y_train)

    print("Model trained successfully")

    return model


# Step 7 : Evaluate Model

#-----------------------------------------------------
#   Function Name : EvaluateModel
#   Description :   It performs model testing
#   Input :         Model, testing features and labels
#   Output :        None
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def EvaluateModel(model, X_test, Y_test):

    Y_pred = model.predict(X_test)

    mse = mean_squared_error(Y_test, Y_pred)

    r2 = r2_score(Y_test, Y_pred)

    print("Mean Squared Error (MSE) : ", mse)

    print("R2 Score : ", r2)


#-----------------------------------------------------
#   Function Name : main
#   Description :   Entry point function
#   Input :         None
#   Output :        None
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def main():

    # Step 1 : Load Data
    df = LoadData("california_housing.csv")

    # Step 2 : Separate Features and Labels
    X, Y = SeparateFeatures(df)

    # Step 3 : Split Data
    X_train, X_test, Y_train, Y_test = SplitData(X, Y)

    # Step 4 : Create Base Model
    base_model = CreateBaseModel()

    # Step 5 : Create Bagging Model
    model = CreateBaggingModel(base_model)

    # Step 6 : Train Model
    model = TrainModel(model, X_train, Y_train)

    # Step 7 : Evaluate Model
    EvaluateModel(model, X_test, Y_test)


if __name__ == "__main__":
    main()
