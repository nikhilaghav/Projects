import pandas as pd
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeClassifier

from sklearn.metrics import (
    accuracy_score,
    confusion_matrix,
    classification_report
)


# Step 1 : Load Data

#-----------------------------------------------------
#   Function Name : LoadData
#   Description :   Load the data from CSV
#   Input :         Name of CSV file
#   Output :        Data Frame
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def LoadData(filename):

    df = pd.read_csv(filename)

    print("Dataset loaded successfully")

    print("Initial entries from dataset : ")
    print(df.head())

    return df


# Step 2 : Exploratory Data Analysis

#-----------------------------------------------------
#   Function Name : AnalyzeData
#   Description :   Perform Exploratory Data Analysis
#   Input :         Data Frame
#   Output :        None
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def AnalyzeData(df):

    print("Shape of dataset : ", df.shape)

    print("Column names : ")
    print(list(df.columns))

    print("Missing values per column : ")
    print(df.isnull().sum())

    print("Class distribution (Species count) : ")
    print(df["species"].value_counts())

    print("Statistical report of dataset : ")
    print(df.describe())

    print("Exploratory Data Analysis completed successfully")


# Step 3 : Separate Features and Labels

#-----------------------------------------------------
#   Function Name : SeparateFeatures
#   Description :   Separate independent and dependent
#                   variables
#   Input :         Data Frame
#   Output :        Features and Labels
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def SeparateFeatures(df):

    feature_cols = [
        "sepal length (cm)",
        "sepal width (cm)",
        "petal length (cm)",
        "petal width (cm)"
    ]

    X = df[feature_cols]

    Y = df["species"]

    print("Feature and label separation completed")

    print("X Shape : ", X.shape)

    print("Y Shape : ", Y.shape)

    return X, Y


# Step 4 : Visualize Dataset

#-----------------------------------------------------
#   Function Name : VisualizeData
#   Description :   Visualize Iris dataset using
#                   Scatter Plot
#   Input :         Data Frame
#   Output :        Scatter Plot
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def VisualizeData(df):

    plt.figure(figsize=(7, 5))

    for sp in df["species"].unique():

        temp = df[df["species"] == sp]

        plt.scatter(
            temp["petal length (cm)"],
            temp["petal width (cm)"],
            label=sp
        )

    plt.title("Iris Flower Classification")

    plt.xlabel("Petal Length (cm)")

    plt.ylabel("Petal Width (cm)")

    plt.legend()

    plt.grid(True)

    plt.show()


# Step 5 : Split Data

#-----------------------------------------------------
#   Function Name : SplitData
#   Description :   It performs dataset splitting
#   Input :         Features and Labels
#   Output :        4 subsets for training and testing
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def SplitData(X, Y):

    X_train, X_test, Y_train, Y_test = train_test_split(
        X,
        Y,
        test_size=0.5,
        random_state=42
    )

    print("Dataset splitting completed successfully")

    print("X : ", X.shape)
    print("Y : ", Y.shape)

    print("X_train : ", X_train.shape)
    print("X_test : ", X_test.shape)

    print("Y_train : ", Y_train.shape)
    print("Y_test : ", Y_test.shape)

    return X_train, X_test, Y_train, Y_test


# Step 6 : Create Model

#-----------------------------------------------------
#   Function Name : CreateModel
#   Description :   Create Decision Tree Classifier
#   Input :         None
#   Output :        Decision Tree Classifier model
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def CreateModel():

    model = DecisionTreeClassifier(max_depth=5)

    print("Decision Tree Classifier created successfully")

    return model


# Step 7 : Train Model

#-----------------------------------------------------
#   Function Name : TrainModel
#   Description :   It performs model training
#   Input :         Model, training features and labels
#   Output :        Trained model
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def TrainModel(model, X_train, Y_train):

    model = model.fit(X_train, Y_train)

    print("Model trained successfully")

    return model


# Step 8 : Test Model

#-----------------------------------------------------
#   Function Name : TestModel
#   Description :   It performs model testing
#   Input :         Model and testing features
#   Output :        Predicted Labels
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def TestModel(model, X_test, Y_test):

    Y_pred = model.predict(X_test)

    print("Model testing completed successfully")

    print("Expected answers : ")
    print(Y_test)

    print("Predicted answers : ")
    print(Y_pred)

    return Y_pred


# Step 9 : Evaluate Model

#-----------------------------------------------------
#   Function Name : EvaluateModel
#   Description :   Evaluate model performance
#   Input :         Actual and Predicted Labels
#   Output :        None
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def EvaluateModel(Y_test, Y_pred):

    accuracy = accuracy_score(Y_test, Y_pred)

    print("Accuracy of model is : ", accuracy * 100)

    print("Confusion Matrix : ")

    cm = confusion_matrix(Y_test, Y_pred)

    print(cm)

    print("Classification Report : ")

    print(classification_report(Y_test, Y_pred))


#-----------------------------------------------------
#   Function Name : main
#   Description :   Entry point function
#   Input :         None
#   Output :        None
#   Author :        Nikhil Aba Aghav
#   Date :          27/10/2026
#-----------------------------------------------------

def main():

    # Step 1 : Load Data
    df = LoadData("iris.csv")

    # Step 2 : Exploratory Data Analysis
    AnalyzeData(df)

    # Step 3 : Separate Features and Labels
    X, Y = SeparateFeatures(df)

    # Step 4 : Visualize Dataset
    VisualizeData(df)

    # Step 5 : Split Data
    X_train, X_test, Y_train, Y_test = SplitData(X, Y)

    # Step 6 : Create Model
    model = CreateModel()

    # Step 7 : Train Model
    model = TrainModel(model, X_train, Y_train)

    # Step 8 : Test Model
    Y_pred = TestModel(model, X_test, Y_test)

    # Step 9 : Evaluate Model
    EvaluateModel(Y_test, Y_pred)


if __name__ == "__main__":
    main()
